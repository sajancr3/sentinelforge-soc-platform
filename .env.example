# SentinelForge Environment Variables
# Copy this to .env and fill in your values.
# .env is gitignored — never commit real keys.

# AbuseIPDB API key (free tier at https://www.abuseipdb.com/api)
ABUSEIPDB_KEY=your_key_here

# CICIDS streamer speed: seconds between events (lower = faster)
STREAM_RATE=0.3
