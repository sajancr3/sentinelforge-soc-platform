from collections import defaultdict

from core.event_bus import get_events
from enrichment.enrich_ip import enrich_ip


def correlate():

    events = get_events()
    ip_map = defaultdict(list)

    for e in events:

        if "ip" not in e:
            continue

        ip_map[e["ip"]].append(e)

    incidents = []

    for ip, evts in ip_map.items():

        auth_failures = [
            e for e in evts
            if e.get("event") == "ssh_failed"
        ]

        ids_alerts = [
            e for e in evts
            if e.get("event") == "ids_alert"
        ]

        # Threat Intelligence Enrichment
        intel = enrich_ip(ip)

        risk_score = 0
        reasons = []

        # SSH Brute Force Detection
        if len(auth_failures) >= 5:

            risk_score += 60

            reasons.append(
                f"SSH brute-force pattern detected ({len(auth_failures)} failures)"
            )

        # IDS Detection
        if len(ids_alerts) >= 1:

            risk_score += 40

            reasons.append(
                f"Suricata IDS alert detected ({len(ids_alerts)} alerts)"
            )

        # Multi-Source Correlation
        if auth_failures and ids_alerts:

            risk_score += 30

            reasons.append(
                "Multi-source correlation: auth failures + IDS alert"
            )

        # Threat Intelligence Correlation
        if intel.get("known_malicious"):

            risk_score += 30

            reasons.append(
                f"Known malicious IP (Abuse Score: {intel.get('abuse_score', 0)})"
            )

        if intel.get("is_tor"):

            risk_score += 20

            reasons.append(
                "Traffic originated from TOR exit node"
            )

        # Risk Classification
        if risk_score >= 90:

            risk = "CRITICAL"

        elif risk_score >= 60:

            risk = "HIGH"

        elif risk_score >= 30:

            risk = "MEDIUM"

        else:
            continue

        # MITRE Mapping
        mitre_techniques = set()

        if auth_failures:
            mitre_techniques.add("T1110")

        if ids_alerts:
            mitre_techniques.add("T1595")

        incidents.append({

            "ip": ip,

            "risk": risk,

            "risk_score": min(risk_score, 100),

            "event_count": len(evts),

            "reasons": reasons,

            "mitre": list(mitre_techniques),

            "threat_intel": {
                "abuse_score": intel.get("abuse_score", 0),
                "country": intel.get("country", "Unknown"),
                "isp": intel.get("isp", "Unknown"),
                "is_tor": intel.get("is_tor", False),
                "total_reports": intel.get("total_reports", 0),
                "known_malicious": intel.get("known_malicious", False)
            },

            "events": evts[-10:]
        })

    return incidents
